{
    "name": "baby-massage-spa/landing-page",
    "description": "Simple Laravel landing page for baby massage and spa tenant.",
    "type": "project",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Support/landing_helpers.php"
        ]
    },
    "scripts": {
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "production:optimize": [
            "@php artisan optimize"
        ],
        "production:clear": [
            "@php artisan optimize:clear"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist"
    }
}
